PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loreroutine
DB_USER=loreroutine_app
DB_PASSWORD=substitua_pela_senha_local
JWT_SECRET=substitua_por_uma_string_aleatoria_longa

# Login com Google: "ID do cliente OAuth" (Aplicativo da Web) do Google Cloud Console.
# Não é segredo. Sem definir, o botão "Entrar com Google" não aparece.
GOOGLE_CLIENT_ID=

# "Esqueci minha senha": envio pelo Gmail. SMTP_PASS é uma "senha de app" do Google
# (myaccount.google.com/apppasswords), não a senha normal da conta.
# Sem definir, o link de redefinição só é impresso no console do servidor (útil em dev).
SMTP_USER=
SMTP_PASS=

# Endereço do frontend usado no link do e-mail de redefinição.
APP_URL=http://localhost:3000

# Produção (Render + Neon): defina DATABASE_URL no lugar das variaveis DB_* acima.
# Formato do Neon: postgresql://usuario:senha@host/banco?sslmode=require
# DATABASE_URL=

# Produção: restringe quem pode chamar a API (URL do frontend publicado).
# Sem definir, aceita qualquer origem (comportamento atual, ok para dev local).
# CORS_ORIGIN=https://seu-frontend.vercel.app
